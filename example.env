# ============================================
# Email Configuration for Schaden-Formular
# ============================================
# This file contains the required environment variables for the application.
# Copy this file to '.env' and replace the example values with your actual credentials.
#
# IMPORTANT: Never commit the .env file with real credentials to version control!

# Sender Email Address
# The email address that will be used to send form submissions
# Example: noreply@yourcompany.com
EMAIL=example@example.com

# Sender Email Password
# The password or app-specific password for the sender email account
# For Gmail, you may need to create an app-specific password
# Example: your-secure-password-here
EMAIL_PASS=your-email-password

# SMTP Server Host
# The hostname of your email provider's SMTP server
# Common examples:
#   - Gmail: smtp.gmail.com
#   - Outlook: smtp-mail.outlook.com
#   - Office365: smtp.office365.com
#   - Custom: mail.yourdomain.com
EMAIL_HOST=smtp.example.com

# SMTP Server Port
# The port number for the SMTP server
# Common ports:
#   - 465 (SSL/TLS - recommended)
#   - 587 (STARTTLS)
#   - 25 (unencrypted - not recommended)
EMAIL_PORT=465

# Destination Email Address
# The email address where form submissions will be sent
# This is where you'll receive notifications from the form
# Example: admin@yourcompany.com
EMAIL_DEST=recipient@example.com